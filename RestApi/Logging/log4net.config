<?xml version="1.0" encoding="utf-8"?>
<log4net>
    <root>
        <level value="ALL"/>
        <appender-ref ref="FileAppender"/>
        <appender-ref ref="JsonFileAppender"/>
        <appender-ref ref="DatabaseAppender"/>
        <appender-ref ref="ApiRateLimitAppender"/>
    </root>

    <appender name="FileAppender" type="log4net.Appender.RollingFileAppender">
        <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE.RestApi.ExceptionMiddleware"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="Microsoft.AspNetCore.Mvc.Filters.RequestSizeLimitFilter"/>
            <acceptOnMatch value="false"/>
        </filter>
        <file value="C://Heappe/projects/develop/app/logs/API/"/>
        <datePattern value="yyyy_MM_dd'.log'"/>
        <appendToFile value="true"/>
        <staticLogFileName value="false"/>
        <lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
        <rollingStyle value="Composite"/>
        <maxSizeRollBackups value="10"/>
        <layout type="log4net.Layout.PatternLayout">
            <converter>
                <name value="userContext" />
                <type value="HEAppE.RestApi.Logging.UserContextPropertyConverter, RestApi" />
            </converter>
            <conversionPattern value="%-5p %utcdate{yyyy-MM-dd HH:mm:ss} UTC %userContext %logger - %message %n"/>
        </layout>
    </appender>

    <appender name="JsonFileAppender" type="log4net.Appender.RollingFileAppender">
        <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE.RestApi.ExceptionMiddleware"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="Microsoft.AspNetCore.Mvc.Filters.RequestSizeLimitFilter"/>
            <acceptOnMatch value="false"/>
        </filter>
        <file value="C://Heappe/projects/develop/app/logs/API/"/>
        <datePattern value="yyyy_MM_dd'.json'"/>
        <appendToFile value="true"/>
        <staticLogFileName value="false"/>
        <lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
        <rollingStyle value="Composite"/>
        <maxSizeRollBackups value="10"/>
        <layout type="HEAppE.RestApi.Logging.JsonLayout, RestApi" />
    </appender>

    <appender name="DatabaseAppender" type="MicroKnights.Logging.AdoNetAppender, MicroKnights.Log4NetAdoNetAppender">
        <bufferSize value="100"/>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE.RestApi.ExceptionMiddleware"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <acceptOnMatch value="false"/>
        </filter>
        <connectionType value="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient"/>
        <commandText value="IF COL_LENGTH('Log', 'RequestId') IS NOT NULL
BEGIN
    EXEC sp_executesql N'INSERT INTO Log([IP], [InstanceName], [InstanceVersion], [LevelId], [Date], [UserId], [UserName], [UserEmail], [JobId], [Message], [Exception], [Class], [RequestId])
                         VALUES (@ip, @instanceName, @instanceVersion, @levelId, @date, @userId, @userName, @userEmail, @jobId, @message, @exception, @class, @requestId)',
                         N'@ip nvarchar(40), @instanceName nvarchar(255), @instanceVersion nvarchar(10), @levelId int, @date datetime, @userId int, @userName nvarchar(255), @userEmail nvarchar(255), @jobId bigint, @message nvarchar(1000), @exception nvarchar(max), @class nvarchar(255), @requestId nvarchar(100)',
                         @ip, @instanceName, @instanceVersion, @levelId, @date, @userId, @userName, @userEmail, @jobId, @message, @exception, @class, @requestId
END
ELSE
BEGIN
    EXEC sp_executesql N'INSERT INTO Log([IP], [InstanceName], [InstanceVersion], [LevelId], [Date], [UserId], [UserName], [UserEmail], [JobId], [Message], [Exception], [Class])
                         VALUES (@ip, @instanceName, @instanceVersion, @levelId, @date, @userId, @userName, @userEmail, @jobId, @message, @exception, @class)',
                         N'@ip nvarchar(40), @instanceName nvarchar(255), @instanceVersion nvarchar(10), @levelId int, @date datetime, @userId int, @userName nvarchar(255), @userEmail nvarchar(255), @jobId bigint, @message nvarchar(1000), @exception nvarchar(max), @class nvarchar(255)',
                         @ip, @instanceName, @instanceVersion, @levelId, @date, @userId, @userName, @userEmail, @jobId, @message, @exception, @class
END"></commandText>


        <parameter>
            <parameterName value="@ip"></parameterName>
            <dbType value="String"></dbType>
            <size value="40"></size>
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%property{ip}"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@instanceName"></parameterName>
            <dbType value="String"></dbType>
            <size value="255"></size>
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%property{instanceName}"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@instanceVersion"></parameterName>
            <dbType value="String"></dbType>
            <size value="10"></size>
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%property{instanceVersion}"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@levelId"></parameterName>
            <dbType value="Int32"></dbType>
            <layout type="HEAppE.RestApi.Logging.LoggingPatternLayout, RestApi">
                <conversionPattern value="%level"/>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@date"></parameterName>
            <dbType value="DateTime"></dbType>
            <layout type="log4net.Layout.RawUtcTimeStampLayout"></layout>
        </parameter>

        <parameter>
            <parameterName value="@userId"></parameterName>
            <dbType value="Int32"></dbType>
            <layout type="log4net.Layout.RawPropertyLayout">
                <key value="userId" />
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@userName"></parameterName>
            <dbType value="String"></dbType>
            <size value="30"></size>
            <layout type="log4net.Layout.PatternLayout">
                <converter>
                    <name value="emptyProperty" />
                    <type value="HEAppE.RestApi.Logging.EmptyIfNullPropertyConverter, RestApi" />
                </converter>
                <conversionPattern value="%emptyProperty{userName}"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@userEmail"></parameterName>
            <dbType value="String"></dbType>
            <size value="50"></size>
            <layout type="log4net.Layout.PatternLayout">
                <converter>
                    <name value="emptyProperty" />
                    <type value="HEAppE.RestApi.Logging.EmptyIfNullPropertyConverter, RestApi" />
                </converter>
                <conversionPattern value="%emptyProperty{userEmail}"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@jobId"></parameterName>
            <dbType value="Int32"></dbType>
            <layout type="log4net.Layout.RawPropertyLayout">
                <key value="jobId" />
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@message"></parameterName>
            <dbType value="String"></dbType>
            <size value="1000"></size>
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%message"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@exception"></parameterName>
            <dbType value="String"></dbType>
            <size value="-1"></size>
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%exception"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@class"></parameterName>
            <dbType value="String"></dbType>
            <size value="255"></size>
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%class"></conversionPattern>
            </layout>
        </parameter>

        <parameter>
            <parameterName value="@requestId"></parameterName>
            <dbType value="String"></dbType>
            <size value="100"></size>
            <layout type="log4net.Layout.RawPropertyLayout">
                <key value="requestId" />
            </layout>
        </parameter>
    </appender>

    <appender name="ApiRateLimitAppender" type="log4net.Appender.RollingFileAppender">
        <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE.RestApi.ExceptionMiddleware"/>
            <acceptOnMatch value="false"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="HEAppE"/>
            <acceptOnMatch value="false"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="Microsoft.AspNetCore.Mvc.Filters.RequestSizeLimitFilter"/>
            <acceptOnMatch value="false"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="AspNetCoreRateLimit"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <loggerToMatch value="Microsoft"/>
            <acceptOnMatch value="true"/>
        </filter>
        <filter type="log4net.Filter.LoggerMatchFilter">
            <acceptOnMatch value="false"/>
        </filter>
        <file value="C://Heappe/projects/develop/app/logs/RateLimit-API/"/>
        <datePattern value="yyyy_MM_dd'.log'"/>
        <appendToFile value="true"/>
        <staticLogFileName value="false"/>
        <lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
        <rollingStyle value="Composite"/>
        <maxSizeRollBackups value="10"/>
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%-5p %utcdate{yyyy-MM-dd HH:mm:ss} UTC %logger - %message %n"/>
        </layout>
    </appender>
</log4net>