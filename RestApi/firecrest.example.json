                        }
                    }
                }
            },
            {
                "MasterNodeName": "daint.alps.cscs.ch",
                "Options": {
                    "Url": "https://api.svc.cscs.ch/hpc/firecrest/v2",
                    "IdpUrl": "https://auth.cscs.ch/auth/realms/firecrest-clients/protocol/openid-connect/token",
                    "ExpirioMetadata": {
                        "SecretName": "firecrest-cscs.ch",
