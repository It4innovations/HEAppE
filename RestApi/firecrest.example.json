{
    "FirecRestConfiguration": {
        "Endpoints": [
            {
                "MasterNodeName": "firecrest-demo.localhost",
                "Options": {
                    "Url": "http://127.0.0.1:8000/",
                    "IdpUrl": "http://127.0.0.1:8080/auth/realms/kcrealm/protocol/openid-connect/token",
                    "ExpirioMetadata": {
                        "SecretName": "firecrest",
