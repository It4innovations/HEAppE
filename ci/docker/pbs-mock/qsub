#!/bin/bash
# Mock qsub for PBS Pro testing

SPOOL_DIR="/var/spool/pbs/jobs"
mkdir -p "$SPOOL_DIR"

JOB_ID=$((RANDOM + 1000)).pbs-mock

# Read stdin or script file
if [ -n "$1" ] && [ -f "$1" ]; then
    cat "$1" > "$SPOOL_DIR/$JOB_ID.script"
else
    cat > "$SPOOL_DIR/$JOB_ID.script"
fi

# Store initial job state
cat << EOF > "$SPOOL_DIR/$JOB_ID.status"
Job Id: $JOB_ID
    Job_Name = test_job
    Job_Owner = testuser@pbs-mock
    job_state = Q
    queue = workq
    server = pbs-mock
    ctime = $(date -u +"%a %b %d %H:%M:%S %Y")
    qtime = $(date -u +"%a %b %d %H:%M:%S %Y")
    mtime = $(date -u +"%a %b %d %H:%M:%S %Y")
    Resource_List.ncpus = 1
    Resource_List.nodect = 1
    Resource_List.walltime = 01:00:00
EOF

# Output the Job ID as expected by PBS qsub
echo "$JOB_ID"
exit 0
