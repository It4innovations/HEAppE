        "RunLocalCmdScriptName": "run_local.sh",
        "GetJobInfoCmdScriptName": "get_job_info.sh",
        "CountJobsCmdScriptName": "count_jobs.sh",
        "CancelJobCmdScriptName": "cancel_job.sh"
      }
