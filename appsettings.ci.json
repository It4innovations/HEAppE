        "ExecuteCmdScriptName": "run_command.sh",
        "CopyDataFromTempCmdScriptName": "copy_data_from_temp.sh",
        "CopyDataToTempCmdScriptName": "copy_data_to_temp.sh"
      },
      "LinuxLocalCommandScriptPathSettings": {
